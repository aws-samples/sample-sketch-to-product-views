{
  "name": "@sketch-to-product-views/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=esm --outfile=../infra/modules/api/build/index.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "test": "env -u AWS_PROFILE -u GUARDRAIL_ID -u GUARDRAIL_VERSION -u AWS_SESSION_TOKEN -u OPENAI_API_KEY AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_REGION=us-east-1 node --test --experimental-test-module-mocks --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.717.0",
    "@sketch-to-product-views/contracts": "*",
    "@sketch-to-product-views/shared": "*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.9.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

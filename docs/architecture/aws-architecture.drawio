5" as="geometry" /></mxCell><mxCell id="xray" value="&lt;b&gt;AWS X-Ray&lt;/b&gt;&lt;br&gt;Active tracing on&lt;br&gt;both Lambdas" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="shared"><mxGeometry x="613" y="50" width="65" height="65" as="geometry" /></mxCell><mxCell id="dlq" value="&lt;b&gt;Amazon SQS&lt;/b&gt;&lt;br&gt;Dead-letter queues&lt;br&gt;(both Lambdas)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="shared"><mxGeometry x="871" y="50" width="65" height="65" as="geometry" /></mxCell><mxCell id="accesslogs" value="&lt;b&gt;Amazon S3 (logs)&lt;/b&gt;&lt;br&gt;Access logs: SPA, artifacts,&lt;br&gt;CloudFront" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="shared"><mxGeometry x="1129" y="50" width="65" height="65" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;① Load the SPA through CloudFront (AWS WAF; private S3 origin via OAC).&lt;br&gt;② Sign in on the Cognito hosted UI (authorization code + PKCE).&lt;br&gt;③ API calls go through CloudFront and AWS WAF under /api/* with the JWT; API Gateway accepts only requests carrying the CloudFront origin secret. The API Lambda presigns uploads, submits revisions and reads status.&lt;br&gt;④ Upload sketches, material sample and metadata straight to S3 with presigned URLs.&lt;br&gt;⑤ The API starts the durable execution on the &lt;i&gt;live&lt;/i&gt; alias.&lt;br&gt;⑥ Analyser and critic run on Amazon Bedrock (Converse).&lt;br&gt;⑦ Views are generated by the OpenAI API with a key from Secrets Manager.&lt;br&gt;⑧ The review decision resumes the parked execution (SendDurableExecutionCallbackSuccess).&lt;br&gt;⑨ Candidates and approved views go to S3; revisions and stage events to DynamoDB." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2080" y="920" width="340" height="330" as="geometry" /></mxCell><mxCell id="f1" value="① HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="cdn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f2" value="② Sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="cognito"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f3" value="③ /api/* (JWT + origin secret)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdn" target="apigw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="400" /><mxPoint x="560" y="759" /></Array></mxGeometry></mxCell><mxCell id="f4" value="④ Presigned upload / download" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="art"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="waf-cdn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="waf" target="cdn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cdn-web" value="OAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdn" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jwt" value="Verify JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F
entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipe" target="openai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f9" value="⑨ Service role (all users):&lt;br&gt;read inputs, write views" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.42375;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipe" target="art"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pipe-ddb" value="Service role (all users):&lt;br&gt;state, stage events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipe" target="ddb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend-gr" value="&lt;b&gt;Guardrail screening&lt;/b&gt; (&lt;i&gt;guardrail_enabled&lt;/i&gt;, default true)&lt;br&gt;Ⓐ Every pipeline Converse call (analyser, critic, notes triage) sends guardrailConfig; only user-written text is wrapped in guardContent.&lt;br&gt;Ⓑ The pipeline calls ApplyGuardrail on user-written text before any of it can reach the OpenAI image prompt: product ID, file names, product details and design notes at Validate; review notes and per-view requests at triage.&lt;br&gt;Ⓒ The API Lambda calls ApplyGuardrail on reviewer notes before the review callback ⑧.&lt;br&gt;A block stops the stage (pipeline) or returns 400 (API) and names the policy, never the text." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2080" y="900" width="340" height="205" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="drawio" pages="1"><diagram id="aws-architecture" name="aws-architecture"><mxGraphModel dx="2640" dy="1640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1540" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2440" height="1540" as="geometry" /></mxCell><mxCell id="title" value="&lt;b&gt;Sketch to product views on AWS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=28;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="50" as="geometry" /></mxCell><mxCell id="user" value="&lt;b&gt;Designer /&lt;/b&gt;&lt;br&gt;reviewer&lt;br&gt;(browser)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=none;dashed=0;labelPosition=left;verticalLabelPosition=middle;verticalAlign=middle;align=right;spacingRight=6;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="130" y="720" width="78" height="78" as="geometry" /></mxCell><mxCell id="cloud" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=1;dropTarget=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;fillColor=none;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="1760" height="1390" as="geometry" /></mxCell><mxCell id="region" value="US East (N. Virginia) us-east-1" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=1;dropTarget=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;fillColor=none;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fontColor=#147EBA;dashed=1;" vertex="1" parent="cloud"><mxGeometry x="380" y="40" width="1360" height="1330" as="geometry" /></mxCell><mxCell id="waf" value="&lt;b&gt;AWS WAF&lt;/b&gt;&lt;br&gt;Web ACL on the distribution&lt;br&gt;(SPA and /api/*): managed&lt;br&gt;rules and rate limits" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="cloud"><mxGeometry x="120" y="60" width="78" height="78" as="geometry" /></mxCell><mxCell id="cdn" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;Default: private S3 SPA (OAC)&lt;br&gt;/api/*: HTTP API origin,&lt;br&gt;adds the x-origin-verify header" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="cloud"><mxGeometry x="120" y="230" width="78" height="78" as="geometry" /></mxCell><mxCell id="web" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;Private SPA bucket, own KMS key&lt;br&gt;(Origin Access Control)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="region"><mxGeometry x="60" y="190" width="78" height="78" as="geometry" /></mxCell><mxCell id="cognito" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;Hosted UI sign-in&lt;br&gt;Authorization code + PKCE" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="region"><mxGeometry x="60" y="380" width="78" height="78" as="geometry" /></mxCell><mxCell id="apigw" value="&lt;b&gt;Amazon API Gateway&lt;/b&gt;&lt;br&gt;HTTP API, 6 routes&lt;br&gt;JWT authorizer (Cognito)&lt;br&gt;No origin-secret check here" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="region"><mxGeometry x="60" y="570" width="78" height="78" as="geometry" /></mxCell><mxCell id="apifn" value="&lt;b&gt;AWS Lambda (API)&lt;/b&gt;&lt;br&gt;Checks x-origin-verify first:&lt;br&gt;403 if missing or wrong&lt;br&gt;(fail closed). Then, as the caller:&lt;br&gt;presign, confirm, submit, status, review" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=right;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=left;spacingRight=4;" vertex="1" parent="region"><mxGeometry x="340" y="570" width="78" height="78" as="geometry" /></mxCell><mxCell id="ddb" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;Keys USER#{sub}#REV#{id}&lt;br&gt;Revisions, stage events,&lt;br&gt;review callback id" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="region"><mxGeometry x="340" y="830" width="78" height="78" as="geometry" /></mxCell><mxCell id="art" value="&lt;b&gt;Amazon S3 (artifacts)&lt;/b&gt;&lt;br&gt;Keys user/{sub}/product/…&lt;br&gt;Input images, candidates, delivery" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="region"><mxGeometry x="840" y="960" width="78" height="78" as="geometry" /></mxCell><mxCell id="bedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Converse API, US geo inference&lt;br&gt;profiles (us-east-1, us-east-2,&lt;br&gt;us-west-2)&lt;br&gt;Analyser: Claude Sonnet 5.5&lt;br&gt;Critic: Claude Sonnet 4.6" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;spacingLeft=6;" vertex="1" parent="region"><mxGeometry x="900" y="270" width="78" height="78" as="geometry" /></mxCell><mxCell id="guardrail" value="&lt;b&gt;Amazon Bedrock Guardrails&lt;/b&gt;&lt;br&gt;Content filters: hate, insults, sexual,&lt;br&gt;violence, misconduct + prompt attack&lt;br&gt;Text, block at MEDIUM, Classic tier&lt;br&gt;Encrypted with the data KMS key&lt;br&gt;guardrail_enabled (default true)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="region"><mxGeometry x="590" y="270" width="78" height="78" as="geometry" /></mxCell><mxCell id="userrole" value="&lt;b&gt;IAM role: api-user-data&lt;/b&gt;&lt;br&gt;Session tag sub = caller&lt;br&gt;Only USER#{sub}#… and&lt;br&gt;user/{sub}/… keys" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;labelPosition=left;verticalLabelPosition=top;align=right;verticalAlign=bottom;spacingRight=4;shape=mxgraph.aws4.role;" vertex="1" parent="region"><mxGeometry x="340" y="753" width="78" height="44" as="geometry" /></mxCell><mxCell id="sts" value="&lt;b&gt;AWS STS&lt;/b&gt;&lt;br&gt;AssumeRole + TagSession" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.sts;" vertex="1" parent="region"><mxGeometry x="480" y="750" width="78" height="50" as="geometry" /></mxCell><mxCell id="secret" value="&lt;b&gt;AWS Secrets Manager&lt;/b&gt;&lt;br&gt;OpenAI API key (or LiteLLM&lt;br&gt;key for that provider)&lt;br&gt;Created outside Terraform" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=middle;verticalAlign=middle;align=right;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;labelPosition=left;spacingRight=6;" vertex="1" parent="region"><mxGeometry x="1220" y="810" width="78" height="78" as="geometry" /></mxCell><mxCell id="pipe" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;strokeWidth=2;container=1;dropTarget=1;pointerEvents=0;collapsible=0;recursiveResize=0;" vertex="1" parent="region"><mxGeometry x="540" y="490" width="800" height="250" as="geometry" /></mxCell><mxCell id="pipe-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="pipe"><mxGeometry x="14" y="12" width="40" height="40" as="geometry" /></mxCell><mxCell id="pipe-title" value="&lt;b&gt;Pipeline: AWS Lambda durable function&lt;/b&gt;&lt;br&gt;Invoked on the &lt;i&gt;live&lt;/i&gt; alias; every step checkpointed" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="62" y="10" width="470" height="44" as="geometry" /></mxCell><mxCell id="s-validate" value="Validate" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="14" y="70" width="112" height="56" as="geometry" /></mxCell><mxCell id="s-analyse" value="Analyse" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="146" y="70" width="112" height="56" as="geometry" /></mxCell><mxCell id="s-spec" value="Complete spec" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="278" y="70" width="112" height="56" as="geometry" /></mxCell><mxCell id="s-prompts" value="Route design notes&lt;br&gt;(if any)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="410" y="70" width="112" height="56" as="geometry" /></mxCell><mxCell id="s-front" value="Generate front" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="542" y="70" width="112" height="56" as="geometry" /></mxCell><mxCell id="s-back" value="Generate back" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="674" y="70" width="112" height="56" as="geometry" /></mxCell><mxCell id="s-sides" value="Left + right&lt;br&gt;(parallel)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="674" y="170" width="112" height="56" as="geometry" /></mxCell><mxCell id="s-eval" value="Evaluate&lt;br&gt;(critic)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="542" y="170" width="112" height="56" as="geometry" /></mxCell><mxCell id="s-review" value="Human review&lt;br&gt;&lt;i&gt;waitForCallback&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;strokeColor=#147EBA;" vertex="1" parent="pipe"><mxGeometry x="410" y="170" width="112" height="56" as="geometry" /></mxCell><mxCell id="s-deliver" value="Deliver" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;" vertex="1" parent="pipe"><mxGeometry x="278" y="170" width="112" height="56" as="geometry" /></mxCell><mxCell id="pipe-note" value="Retry remakes only the rejected views. After review, reviewer notes can regenerate views (up to 3 rounds)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#5A6C86;" vertex="1" parent="pipe"><mxGeometry x="14" y="170" width="238" height="56" as="geometry" /></mxCell><mxCell id="c-s-validate-s-analyse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="s-validate" target="s-analyse"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c-s-analyse-s-spec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="s-analyse" target="s-spec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c-s-spec-s-prompts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="s-spec" target="s-prompts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c-s-prompts-s-front" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="s-prompts" target="s-front"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c-s-front-s-back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="s-front" target="s-back"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c-back-sides" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="s-back" target="s-sides"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c-sides-eval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="s-sides" target="s-eval"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c-eval-retry" value="retry (attempt budget 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;strokeColor=#A36918;fontColor=#A36918;" edge="1" parent="pipe" source="s-eval" target="s-front"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c-eval-review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="s-eval" target="s-review"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c-review-deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#ED7100;endArrow=block;endFill=1;endSize=5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pipe" source="s-review" target="s-deliver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ext" value="External SaaS (outside AWS)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C86;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#5A6C86;container=1;dropTarget=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2100" y="690" width="300" height="180" as="geometry" /></mxCell><mxCell id="openai" value="&lt;b&gt;OpenAI API&lt;/b&gt;&lt;br&gt;/v1/images/edits&lt;br&gt;GPT Image 2.6 Sunburst&lt;br&gt;(registry default)&lt;br&gt;Alternative: a LiteLLM gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=none;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.internet_alt2;" vertex="1" parent="ext"><mxGeometry x="16" y="51" width="78" height="78" as="geometry" /></mxCell><mxCell id="shared" value="Shared security, logging and observability" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#5A6C86;container=1;dropTarget=1;pointerEvents=0;collapsible=0;" vertex="1" parent="region"><mxGeometry x="40" y="1100" width="1290" height="200" as="geometry" /></mxCell><mxCell id="kms" value="&lt;b&gt;AWS KMS&lt;/b&gt;&lt;br&gt;Data key (S3, DynamoDB, SQS,&lt;br&gt;durable state, guardrail);&lt;br&gt;logs, WAF logs and web keys" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="shared"><mxGeometry x="97" y="50" width="65" height="65" as="geometry" /></mxCell><mxCell id="logs" value="&lt;b&gt;Amazon CloudWatch Logs&lt;/b&gt;&lt;br&gt;Lambdas, API access, WAF" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="shared"><mxGeometry x="355" y="50" width="65" height="65" as="geometry" /></mxCell><mxCell id="xray" value="&lt;b&gt;AWS X-Ray&lt;/b&gt;&lt;br&gt;Active tracing on&lt;br&gt;both Lambdas" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="shared"><mxGeometry x="613" y="50" width="65" height="65" as="geometry" /></mxCell><mxCell id="dlq" value="&lt;b&gt;Amazon SQS&lt;/b&gt;&lt;br&gt;Dead-letter queues&lt;br&gt;(both Lambdas)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="shared"><mxGeometry x="871" y="50" width="65" height="65" as="geometry" /></mxCell><mxCell id="accesslogs" value="&lt;b&gt;Amazon S3 (logs)&lt;/b&gt;&lt;br&gt;Access logs: SPA, artifacts,&lt;br&gt;CloudFront" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="shared"><mxGeometry x="1129" y="50" width="65" height="65" as="geometry" /></mxCell><mxCell id="gr-converse" value="Ⓐ guardrailConfig" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;dashed=1;strokeColor=#01A88D;fontColor=#016E5C;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bedrock" target="guardrail"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="gr-pipe" value="Ⓑ ApplyGuardrail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;strokeColor=#01A88D;fontColor=#016E5C;exitX=0.11125;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipe" target="guardrail"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="gr-api" value="Ⓒ ApplyGuardrail&lt;br&gt;(review notes)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;strokeColor=#01A88D;fontColor=#016E5C;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apifn" target="guardrail"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="api-art" value="As user-data role: confirm upload (HEAD + first 16 bytes)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.385;entryDx=0;entryDy=0;" edge="1" parent="1" source="userrole" target="art"><mxGeometry relative="1" as="geometry" x="0.35"><Array as="points"><mxPoint x="940" y="925" /><mxPoint x="940" y="1140" /></Array></mxGeometry></mxCell><mxCell id="sts-call" value="AssumeRole&lt;br&gt;(tag sub = caller)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apifn" target="sts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1039" y="850" /><mxPoint x="1179" y="850" /></Array></mxGeometry></mxCell><mxCell id="sts-role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sts" target="userrole"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend-iso" value="&lt;b&gt;Per-user isolation&lt;/b&gt; (D-32)&lt;br&gt;The API function's own role has no DynamoDB or S3 access. For each request it calls STS AssumeRole on api-user-data with the caller's verified Cognito sub as the only session tag. That role allows DynamoDB only where dynamodb:LeadingKeys match USER#{sub}#* and S3 only under user/{sub}/*, so IAM denies a cross-user read or write even if the code builds a wrong key. The ownership checks in code still run.&lt;br&gt;Residual risk: the pipeline keeps its service role on the whole table and bucket, because it runs long after the user's session." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2080" y="1125" width="340" height="215" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;① Load the SPA through CloudFront (AWS WAF; private S3 origin via OAC).&lt;br&gt;② Sign in on the Cognito hosted UI (authorization code + PKCE).&lt;br&gt;③ API calls go through CloudFront and AWS WAF under /api/* with the JWT; CloudFront adds the x-origin-verify secret header. API Gateway validates only the JWT. The API Lambda checks x-origin-verify before routing and returns 403 if it is missing or wrong (fail closed). It then runs the route as the caller (per-user isolation below): presigns and confirms uploads, submits revisions, reads status and takes review decisions.&lt;br&gt;④ The browser uploads images (sketches, photos, material samples) straight to S3 with presigned URLs and reads results the same way. The URLs are signed with the caller's user-data role credentials (PUT 15 minutes, GET 45 minutes). Product details go in the submit body.&lt;br&gt;⑤ The API records the revision in DynamoDB (as the user-data role) and starts the durable execution on the &lt;i&gt;live&lt;/i&gt; alias (asynchronous invoke).&lt;br&gt;⑥ Analyser and critic run on Amazon Bedrock (Converse).&lt;br&gt;⑦ Views are generated by the OpenAI API with a key from Secrets Manager.&lt;br&gt;⑧ The review decision resumes the parked execution (SendDurableExecutionCallbackSuccess).&lt;br&gt;⑨ With its own service role (all users' keys), the pipeline reads inputs from S3 and writes candidates and delivered views there; revision state and stage events go to DynamoDB." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2080" y="110" width="340" height="500" as="geometry" /></mxCell><mxCell id="f1" value="① HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="cdn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f2" value="② Sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="cognito"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f3" value="③ /api/* + JWT&lt;br&gt;CloudFront adds x-origin-verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdn" target="apigw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="400" /><mxPoint x="560" y="759" /></Array></mxGeometry></mxCell><mxCell id="f4" value="④ Presigned upload / download" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="art"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="waf-cdn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="waf" target="cdn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cdn-web" value="OAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdn" target="web"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jwt" value="Verify JWT (Cognito JWKS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="cognito"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="apifn" value="JWT valid"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f5" value="⑤ Invoke (async)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#232F3E;endArrow=block;endFill=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#F5F5F5;exitX=1;exitY=0.32;exitDx=0;exitDy=0;entryX=0;entryY=0.4198;entryDx=0;entryDy=0;" edge="1" parent="1" source="apifn" target="pipe"><mxGeometry relative="1" as="geometry" /></mxCell
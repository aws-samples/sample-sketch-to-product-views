{
  "name": "@sketch-to-product-views/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "npm run bundle:js && npm run bundle:sharp",
    "bundle:js": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=esm --external:sharp --outfile=../infra/modules/pipeline/build/index.mjs --banner:js=\"import{createRequire as __createRequire}from'node:module';const require=__createRequire(import.meta.url);\"",
    "bundle:sharp": "bash scripts/vendor-sharp.sh",
    "test": "env -u AWS_PROFILE -u GUARDRAIL_ID -u GUARDRAIL_VERSION -u AWS_SESSION_TOKEN -u OPENAI_API_KEY AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_REGION=us-east-1 node --test --experimental-test-module-mocks --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@aws/durable-execution-sdk-js": "^2.4.0",
    "@sketch-to-product-views/contracts": "*",
    "@sketch-to-product-views/shared": "*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
